# syntax=docker/dockerfile:1
# Dev-mode image: runs the Vite dev server with hot module reload.
# Used only by infra/compose/compose.local.yml — NOT used for staging/production.
# Staging/production use the multi-stage Dockerfile in this same directory.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host"]
